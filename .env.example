# Database Connection (PostgreSQL or SQLite fallback for local development)
DATABASE_URL=sqlite:///./news.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/news_scraper

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=dev_secret_api_key_change_in_production

# Logging
LOG_LEVEL=INFO

# Scraper Settings
SCRAPE_INTERVAL_MARKET_SECONDS=120
SCRAPE_INTERVAL_OFF_HOURS_SECONDS=900
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

# Data Retention
BODY_RETENTION_DAYS=90
